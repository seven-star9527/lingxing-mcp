{$MCP_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	reverse_proxy lingxing-mcp:8099

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format filter {
			request>headers>X-Mcp-Key delete
			wrap json
		}
	}
}
