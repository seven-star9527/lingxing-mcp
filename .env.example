# 领星 OpenAPI 企业级凭据，仅保存在服务器
LINGXING_APP_ID=
LINGXING_APP_SECRET=
LINGXING_BASE_URL=https://openapi.lingxing.com

# 使用 `npm run admin -- generate-pepper` 生成，至少 32 个字符
LINGXING_MCP_KEY_PEPPER=

# Docker 内部监听
LINGXING_MCP_HOST=0.0.0.0
LINGXING_MCP_PORT=8099
LINGXING_MCP_DATA_DIR=/data
LINGXING_MCP_DB_PATH=/data/access.sqlite

# 权限每 300 秒从领星 ERP 自动刷新；刷新失败时 fail closed
LINGXING_PERMISSION_SYNC_TTL_SECONDS=300
LINGXING_MCP_SESSION_TTL_SECONDS=1800
LINGXING_MCP_MAX_SESSIONS=500
LINGXING_MCP_MAX_SESSIONS_PER_KEY=5
LINGXING_REQUEST_TIMEOUT_MS=30000
LINGXING_MAX_RESPONSE_BYTES=5242880

# 浏览器型 MCP Client 使用时填写精确 Origin，多个值用逗号分隔；非浏览器 Agent 可留空
LINGXING_MCP_ALLOWED_ORIGINS=

# 若通过自建领星中继访问，可选配置
LINGXING_RELAY_TOKEN=

# Caddy 自动 HTTPS 使用的域名
MCP_DOMAIN=mcp.example.com
